{
  "name": "emergency-fund-tracker",
  "version": "1.0.0",
  "description": "Size and fill an emergency fund. Runs entirely on device.",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:component": "jest --selectProjects component",
    "test:a11y": "jest --selectProjects component --testPathPatterns \"a11y|contrast|text-scale|chart-frame\"",
    "test:coverage": "jest --coverage",
    "e2e": "maestro test e2e",
    "seed": "node --experimental-strip-types scripts/seed.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "expo": "^57.0.13",
    "expo-constants": "~57.0.11",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
